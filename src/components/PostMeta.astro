---
const { date, category, tags = [] } = Astro.props;
import { withBase } from '../utils/paths';
const formatted = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul' }).format(date);
---
<div class="meta"><time datetime={date.toISOString()}>{formatted}</time><span>·</span><a href={withBase(`/category/${encodeURIComponent(category)}`)}>{category}</a>{tags.length > 0 && <span class="tags">· {tags.map((tag) => <a href={withBase(`/tag/${encodeURIComponent(tag)}`)}>#{tag}</a>)}</span>}</div>
<style>.meta{display:flex;gap:9px;align-items:center;color:#888;font-size:13px;margin:14px 0 34px;flex-wrap:wrap}.meta a{color:#555}.tags{display:flex;gap:8px;flex-wrap:wrap}</style>

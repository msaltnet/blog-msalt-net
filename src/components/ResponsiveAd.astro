---
const { slot } = Astro.props;
---
<div class="ad-unit" aria-label="광고">
  <ins class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-7998090459933600"
    data-ad-slot={slot}
    data-ad-format="auto"
    data-full-width-responsive="true"></ins>
</div>
<script is:inline>
  (window.adsbygoogle = window.adsbygoogle || []).push({});
</script>
<style>
  .ad-unit{width:100%;margin:24px 0;min-width:0}
</style>

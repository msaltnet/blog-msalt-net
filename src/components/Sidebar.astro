---
import { getCollection } from 'astro:content';
import { categoryOrder } from '../data/site';
const posts = await getCollection('posts', ({ data }) => !data.draft);
const counts = new Map(categoryOrder.map((name) => [name, posts.filter((post) => post.data.category === name).length]));
---
<aside class="sidebar" aria-label="블로그 메뉴">
  <section class="profile"><h2>맛소금</h2><p>고마워서 만든 블로그</p><a href="/category/About%20Blog">블로그 소개 →</a></section>
  <section class="categories"><h2>카테고리</h2><ul>{categoryOrder.map((name) => <li><a href={`/category/${encodeURIComponent(name)}`}>{name}<span>{counts.get(name) ?? 0}</span></a></li>)}</ul></section>
  <a class="side-link" href="/rss">RSS 구독 <span>↗</span></a>
</aside>
<style>
  .sidebar{font-size:14px}.profile{background:#f7f7f7;padding:22px 24px;margin-bottom:26px}.profile h2{font-size:18px;margin:0 0 8px}.profile p{color:#777;margin:0 0 16px}.profile>a{font-size:12px}.categories h2{font-size:15px;margin:0 0 12px}.categories ul{list-style:none;padding:0;margin:0}.categories li{border-top:1px solid #eee}.categories li a{display:flex;justify-content:space-between;padding:11px 2px}.categories span{color:#aaa;font-size:12px}.side-link{margin-top:26px;padding:18px 20px;background:#171717;color:white;display:flex;justify-content:space-between}.side-link:hover{color:var(--green)}
</style>

---
import { categoryOrder, site } from '../data/site';
---
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/" aria-label={site.title}><img src="/logo.png" alt={site.title} width="151" height="32" /></a>
    <div class="tools">
      <details class="category-menu">
        <summary>분류 보기 <span aria-hidden="true">⌄</span></summary>
        <nav class="category-panel" aria-label="카테고리">
          {categoryOrder.map((category) => <a href={`/category/${encodeURIComponent(category)}`}>{category}</a>)}
        </nav>
      </details>
      <form class="search" action="/search" method="get" role="search">
        <label class="sr-only" for="site-search">블로그 검색</label>
        <input id="site-search" type="search" name="q" placeholder="Search" autocomplete="off" />
        <button type="submit" aria-label="검색">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4"/><path d="m16 16 4.2 4.2"/></svg>
        </button>
      </form>
    </div>
  </div>
</header>
<style>
  .topbar{height:40px;position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid #e8e8e8;box-shadow:0 -8px 16px 5px #333}
  .topbar-inner{width:min(1180px,calc(100% - 40px));height:100%;margin:auto;display:flex;align-items:center;justify-content:space-between}
  .brand{display:flex;align-items:center;height:100%}.brand img{display:block;width:151px;height:32px;object-fit:contain;object-position:left center}
  .tools{height:100%;display:flex;align-items:center;gap:26px;color:#777}
  .category-menu{height:100%;position:relative;display:flex;align-items:center;font-size:14px}
  .category-menu summary{cursor:pointer;list-style:none;white-space:nowrap}.category-menu summary::-webkit-details-marker{display:none}.category-menu summary span{font-size:12px;margin-left:2px}
  .category-panel{position:absolute;right:-18px;top:39px;width:210px;max-height:min(70vh,520px);overflow:auto;display:grid;background:#fff;border:1px solid #e9e9e9;box-shadow:0 8px 24px #00000016;padding:8px 0}
  .category-panel a{padding:10px 16px;font-size:13px;color:#555}.category-panel a:hover{background:#f4f8f5;color:#168f58}
  .search{height:34px;width:310px;display:flex;align-items:center;gap:8px}.search input{width:100%;height:34px;border:1px solid #d8d8d8;border-radius:4px;padding:0 11px;font:13px Arial,sans-serif;outline:none}.search input:focus{border-color:#999}.search input::-webkit-search-cancel-button{cursor:pointer}
  .search button{width:28px;height:32px;flex:0 0 28px;border:0;background:transparent;padding:4px;cursor:pointer;color:#777}.search button svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:640px){.topbar-inner{width:calc(100% - 24px)}.brand img{width:132px;height:30px}.tools{gap:12px}.category-menu{font-size:12px}.search{width:min(38vw,210px);gap:4px}.search input{font-size:12px;padding:0 8px}.category-panel{right:-80px}}
</style>

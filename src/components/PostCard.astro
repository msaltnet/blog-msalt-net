---
const { post } = Astro.props;
import { withBase } from '../utils/paths';
const path = withBase(`/${post.data.id}`);
---
<article class="post-card"><p class="category"><a href={withBase(`/category/${encodeURIComponent(post.data.category)}`)}>{post.data.category}</a></p><h2><a href={path}>{post.data.title}</a></h2><p class="summary">{post.data.description}</p><time datetime={post.data.date.toISOString()}>{new Intl.DateTimeFormat('ko-KR',{year:'numeric',month:'long',day:'numeric',timeZone:'Asia/Seoul'}).format(post.data.date)}</time></article>
<style>.post-card{padding:27px 0 30px;border-bottom:1px solid var(--line)}.category{font-size:12px;color:#00a963;margin:0 0 10px}.post-card h2{font:600 22px/1.8 "Malgun Gothic",Tahoma,sans-serif;margin:0 0 10px}.summary{font-size:14px;line-height:1.8;color:#666;margin:0 0 15px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.post-card time{font-size:12px;color:#999}</style>

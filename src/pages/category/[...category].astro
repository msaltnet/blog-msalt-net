---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TitleBanner from '../../components/TitleBanner.astro';
import PostCard from '../../components/PostCard.astro';
import { categoryOrder } from '../../data/site';
export async function getStaticPaths() {
  return categoryOrder.map((category) => ({ params: { category }, props: { category } }));
}
const { category } = Astro.props;
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.category === category)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const pages = Math.max(1, Math.ceil(posts.length / 20));
---
<BaseLayout title={`${category} | 맛소금`} canonical={`/category/${encodeURIComponent(category)}`}>
  <TitleBanner slot="banner" title="분류별 검색 결과" eyebrow={category} subtitle={`총 ${posts.length}개`} />
  <section class="listing">{posts.map((post) => <div data-pageable><PostCard post={post} /></div>)}
    <nav class="pagination" aria-label="페이지 이동"><a data-page-link="first" href="?page=1">처음</a><a data-page-link="prev" href="?page=1">← 이전</a><span data-page-label>1 / {pages}</span><a data-page-link="next" href="?page=2">다음 →</a><a data-page-link="last" href={`?page=${pages}`}>마지막</a></nav>
  </section>
</BaseLayout>
<script>import '../../scripts/pagination';</script>
<style>.listing{min-height:300px}.pagination{display:flex;justify-content:center;align-items:center;gap:26px;padding:28px 0;color:#777;font-size:13px}</style>

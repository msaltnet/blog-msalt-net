---
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/paths';
const { title = site.title, description = site.description, canonical = Astro.url.pathname, image = '', imageAlt = '', type = 'website', noindex = false } = Astro.props;
const canonicalUrl = new URL(canonical, site.url).toString();
const normalizedDescription = description.replace(/\s+/g, ' ').trim();
const summary = normalizedDescription.length > 160
  ? `${normalizedDescription.slice(0, 159).trimEnd()}…`
  : normalizedDescription;
const shareImage = new URL(image || site.shareImage, site.url).toString();
const shareImageAlt = image ? (imageAlt || title) : site.title;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nanum+Gothic:wght@400;700&family=Nanum+Myeongjo:wght@400;500;700;800&family=Raleway:wght@400&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/font-iropke-batang/1.2/font-iropke-batang.css" />
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={summary} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={shareImageAlt} />
    {!image && <meta property="og:image:width" content="1024" />}
    {!image && <meta property="og:image:height" content="1024" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase('/rss')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Blog', name: site.title,
      description: site.description, url: site.url,
    })} />
  </head>
  <body>
    <Header />
    <slot name="banner" />
    <main class="site-main">
      <div class="main-column"><slot /></div>
      <Sidebar />
    </main>
    <Footer />
  </body>
</html>
<style is:global>
  :root{font-family:"Malgun Gothic",Tahoma,sans-serif;color:#242424;background:#fff;font-synthesis:none;text-rendering:optimizeLegibility;--green:#00d27a;--muted:#888;--line:#ececec}
  *{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}a:hover{color:#00a963}.site-main{width:min(1180px,calc(100% - 40px));margin:44px auto 80px;display:grid;grid-template-columns:minmax(0,790px) 280px;gap:64px;align-items:start}.main-column{min-width:0}img{max-width:100%;height:auto}
  @media(max-width:850px){.site-main{grid-template-columns:1fr;gap:40px;margin-top:30px}.sidebar{order:2}}
</style>
